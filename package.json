{
  "name": "concord-eng-exercise",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run generate:routes && tsc -p tsconfig.json && tsc -p tsconfig.server.json && vite build",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "preview": "vite preview",
    "dev:api": "bun --watch server/index.ts",
    "setup-database": "(test -f .env || cp .env.example .env) && bun run db:up && bun run db:push && bun run db:seed:dev",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:seed:dev": "bun server/seed/run.ts",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "generate:routes": "bun --bun tsr generate",
    "test": "bun run generate:routes && bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^9.2.6",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "11.19.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.52.0",
    "postgres": "^3.4.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.21.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.6",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "~6.0.2",
    "ultracite": "^7.2.5",
    "vite": "^8.1.0"
  },
  "packageManager": "bun@1.3.8"
}
